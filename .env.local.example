# Local Development Environment Variables
# Copy this to .env.local for local development

# For local dev, point to local backend
REACT_APP_API_URL=http://localhost:3001

# Vapi Configuration (Frontend)
REACT_APP_VAPI_PUBLIC_KEY=your_vapi_public_key_here
REACT_APP_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Note: Backend variables (AIRTABLE_*, VAPI_API_KEY)
# should be set in your local .env file for the Express server
