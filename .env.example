# Vapi Configuration (Frontend - prefix with REACT_APP_)
REACT_APP_VAPI_PUBLIC_KEY=your_vapi_public_key_here
REACT_APP_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Vapi Configuration (Backend - for serverless functions)
VAPI_API_KEY=your_vapi_api_key_here

# AirTable Configuration (Backend - for serverless functions)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_NAME=DailyTasks

# API URL (Frontend)
# Leave empty for Vercel (uses same domain)
# For local dev: http://localhost:3001
REACT_APP_API_URL=

# Optional: Piano app URL
PIANO_APP_URL=https://your-piano-app-link.com
